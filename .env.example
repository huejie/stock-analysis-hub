# 百度 OCR API 配置
BAIDU_OCR_API_KEY=你的API_KEY
BAIDU_OCR_SECRET_KEY=你的SECRET_KEY

# LLM 配置（OpenAI 兼容 API，支持 Hermes / DeepSeek / Ollama 等）
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=Hermes
LLM_MAX_TOKENS=0
LLM_TEMPERATURE=0.7

# 交易决策模块配置(spec §13.3)
TRADING_ENABLED=true
TRADING_TIMEZONE=Asia/Shanghai
TRADING_SCHEDULE_ENABLED=false
TRADING_PLAN_CRON=25 20 * * 1-5
TRADING_PROVIDER_PRIORITY=eastmoney,akshare
TRADING_PROVIDER_TIMEOUT_SECONDS=20
TRADING_PROVIDER_MAX_RETRIES=3
TRADING_DATA_MAX_MISSING_RATIO=0.05
TRADING_BENCHMARK_CODES=000300.SH,000905.SH
TRADING_BACKUP_RETENTION_DAYS=30
